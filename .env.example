# ============================================================
# 复制为 .env 后按需修改。.env 不进版本库。
# 所有服务只从这里读配置，代码里不出现任何硬编码的值。
# ============================================================

# ---------- 运行环境 ----------
NODE_ENV=development
# web 端口
WEB_PORT=3000
# api 端口
API_PORT=4000

# ---------- PostgreSQL ----------
POSTGRES_USER=ticket
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=ticket_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# 连接池上限。留空时由应用按 CPU 核数推导
DATABASE_POOL_MAX=
# 应用连接串（含连接池参数）
DATABASE_URL=postgresql://ticket:change_me_local@localhost:5432/ticket_dev?schema=public&connection_limit=10

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---------- 鉴权 ----------
# access token 有效期（秒）。短，泄露窗口小
JWT_ACCESS_TTL=900
# refresh token 有效期（秒）。长，但入库存哈希、可吊销
JWT_REFRESH_TTL=604800
# 两个密钥必须不同，且长度 >= 32。生成命令：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_random_48_bytes
JWT_REFRESH_SECRET=replace_with_another_random_48_bytes
# cookie 作用域，生产环境改成真实域名
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---------- 模型服务（OpenAI 兼容接口）----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-chat
# 分类这类简单任务走小模型，省钱
LLM_FAST_MODEL=deepseek-chat
# embedding 接口与维度必须和数据库 vector(n) 一致
LLM_EMBED_MODEL=text-embedding-v3
LLM_EMBED_DIM=1024
LLM_TIMEOUT_MS=60000

# ---------- 对象存储 ----------
# 本地开发写 local，文件落到 .data/uploads
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 单文件上限（字节），默认 10MB
UPLOAD_MAX_BYTES=10485760

# ---------- 可观测 ----------
LOG_LEVEL=debug
# 留空则不启用
SENTRY_DSN=
