{
  "name": "ticket-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres redis",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -c \"select version();\"",
    "db:tables": "docker compose exec postgres psql -c \"\\dt\"",
    "db:indexes": "docker compose exec postgres psql -c \"\\di\"",
    "db:shell": "docker compose exec postgres psql",
    "db:redis": "docker compose exec redis redis-cli ping",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "lint": "pnpm -r --if-present lint",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test"
  }
}
